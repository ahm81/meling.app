{
  "name": "@meling/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:emulator": "vitest run -c vitest.emulator.config.ts",
    "try-analysis": "tsup scripts/try-analysis.ts --no-config --format esm --target node22 --out-dir .try-analysis --silent && node .try-analysis/try-analysis.js"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "mupdf": "^1.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
