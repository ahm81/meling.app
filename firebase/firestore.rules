rules_version = '2';

// Data model: docs/datamodel.md
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberIds;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // familyIds is managed by Cloud Functions only.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email'])
        && request.resource.data.displayName is string;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email']);
      allow delete: if false;
    }

    // Families and memberships are created via the createFamily function.
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow update: if isFamilyMember(familyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow create, delete: if false;

      match /members/{uid} {
        allow read: if isFamilyMember(familyId);
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
        allow create, delete: if false;
      }
    }
  }
}
