rules_version = '2';

// meling.app is for the Meling family only. Data model: docs/datamodel.md
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user is a family member if and only if members/{uid} exists.
    // Members are added with `pnpm add-member`, never by clients.
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // Adults can manage content in services such as the christmas calendar.
    // Roles are set with `pnpm add-member --role`, never by clients.
    function isAdult() {
      return isMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == "adult";
    }

    match /members/{uid} {
      allow read: if isMember();
      allow update: if isMember() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow create, delete: if false;
    }

    // Julekalender: only adults. Versions and pages are written by functions (admin SDK) only.
    match /julekalender/{calId} {
      allow read: if isAdult();
      allow create: if isAdult()
        && request.resource.data.keys().hasOnly(
          ['year', 'childUid', 'childName', 'wishes', 'currentVersion', 'draft', 'draftError', 'createdBy'])
        && request.resource.data.keys().hasAll(
          ['year', 'childUid', 'childName', 'wishes', 'currentVersion', 'draft', 'draftError', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.currentVersion == null
        && request.resource.data.draft == 'waiting'
        && request.resource.data.draftError == null;
      allow update: if isAdult()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wishes', 'childName']);
      allow delete: if false;

      match /manuals/{manualId} {
        allow read: if isAdult();
        allow create: if isAdult()
          && request.resource.data.keys().hasOnly(
            ['order', 'fileName', 'storagePath', 'status', 'pageCount', 'pagesAnalyzed', 'setNumber', 'error'])
          && request.resource.data.keys().hasAll(
            ['order', 'fileName', 'storagePath', 'status', 'pageCount', 'pagesAnalyzed', 'setNumber', 'error'])
          && request.resource.data.order is int && request.resource.data.order >= 1
          && request.resource.data.fileName is string
          && request.resource.data.storagePath == 'julekalender/' + calId + '/manuals/' + manualId + '.pdf'
          && request.resource.data.status == 'uploaded'
          && request.resource.data.pageCount == null
          && request.resource.data.pagesAnalyzed == 0
          && request.resource.data.setNumber == null
          && request.resource.data.error == null;
        allow update, delete: if false;
      }

      match /pages/{pageId} {
        allow read: if isAdult();
        allow write: if false;
      }

      match /versions/{versionId} {
        allow read: if isAdult();
        allow write: if false;
      }
    }

    // New services get their own match block using isMember().
  }
}
