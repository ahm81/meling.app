rules_version = '2';

// meling.app is for the Meling family only. Data model: docs/datamodel.md
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user is a family member if and only if members/{uid} exists.
    // Members are added with `pnpm add-member`, never by clients.
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    match /members/{uid} {
      allow read: if isMember();
      allow update: if isMember() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow create, delete: if false;
    }

    // New services (e.g. christmasCalendar) get their own match block using isMember().
  }
}
