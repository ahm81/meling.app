# Firebase web config for meling-app. Access is controlled by Firebase Auth and the security rules.
# VITE_FIREBASE_API_KEY is not committed: CI sets it from the repository variable FIREBASE_WEB_API_KEY.
# For a local production build, put it in .env.production.local (gitignored).
VITE_FIREBASE_AUTH_DOMAIN=meling-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=meling-app
VITE_FIREBASE_STORAGE_BUCKET=meling-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=247508425974
VITE_FIREBASE_APP_ID=1:247508425974:web:528011dff13cd2304920d7
VITE_USE_EMULATORS=false
