# Copy to .env.local for local development against the emulators.
# Production values live in .env.production.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=meling-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=meling-app
VITE_FIREBASE_STORAGE_BUCKET=meling-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=247508425974
VITE_FIREBASE_APP_ID=1:247508425974:web:528011dff13cd2304920d7

# Connect to the local Emulator Suite (pnpm emulators) instead of production.
VITE_USE_EMULATORS=true
